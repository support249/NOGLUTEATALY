# Brevo (Sendinblue) — contact form
# Create an API key: https://app.brevo.com/settings/keys/api
# Verify a sender: https://app.brevo.com/senders
#
# Copy this file to `.env.local` and fill in real values.
# Do NOT put real secrets in `.env.example` (it can be committed to git).

BREVO_API_KEY=xkeysib-xxxxxxxx
# Brevo “From” address — must be verified and must NOT equal CONTACT_TO_EMAIL (Gmail shows "me").
BREVO_SENDER_EMAIL=noreply@your-verified-domain.com
BREVO_SENDER_NAME=NOGLUTEATALY

# Inbox that receives enquiries (can be reservations@, Gmail, etc.)
CONTACT_TO_EMAIL=reservations@your-verified-domain.com
